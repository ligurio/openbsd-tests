// RFC 4443 §3.1: Destination Unreachable Message.
// RFC 1122 §4.2.3.9: ICMP messages.
//
// ICMPv6 port unreachable for a datagram sent from a connected UDP
// socket is reported to the application as ECONNREFUSED.
--ip_version=ipv6
--tolerance_usecs=100000

0.000 socket(..., SOCK_DGRAM, IPPROTO_UDP) = 3
0.000 connect(3, ..., ...) = 0

0.100 send(3, ..., 1000, 0) = 1000
0.100 > udp(1000)

0.200 < icmp unreachable port_unreachable [udp(1000)]
0.200 recv(3, ..., 1000, 0) = -1 ECONNREFUSED (Connection refused)
