// RFC 2385 §2: TCP MD5 Signature Option.
//
// A SYN with an invalid MD5 digest is dropped.  A following SYN with a
// valid digest still completes the handshake.
--tolerance_usecs=1000000
--tcp_md5_secret=secret

0.000 `scripts/setup-md5-sa.sh`
0.000 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
0.000 setsockopt(3, SOL_SOCKET, SO_REUSEADDR, [1], 4) = 0
0.000 setsockopt(3, IPPROTO_TCP, TCP_MD5SIG, [1], 4) = 0
0.000 bind(3, ..., ...) = 0
0.000 listen(3, 1) = 0

0.100 < S 0:0(0) win 65535 <mss 1000,sackOK,nop,nop,nop,wscale 7,md5 00000000000000000000000000000000,nop,nop>
0.200 < S 0:0(0) win 65535 <mss 1000,sackOK,nop,nop,nop,wscale 7,md5 valid,nop,nop>
0.200 > S. 0:0(0) ack 1 <mss 1460,nop,wscale 6,md5 valid,nop,eol>
0.200 < . 1:1(0) ack 1 win 65535 <md5 valid,nop,nop>
0.200 accept(3, ..., ...) = 4
