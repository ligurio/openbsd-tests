// RFC 2385 §2: TCP MD5 Signature Option.
//
// A data segment without the MD5 option is dropped.  The same segment
// with a valid digest is acknowledged.
--tolerance_usecs=1000000
--tcp_md5_secret=secret

0.000 `scripts/setup-md5-sa.sh`
0.000 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
0.000 setsockopt(3, SOL_SOCKET, SO_REUSEADDR, [1], 4) = 0
0.000 setsockopt(3, IPPROTO_TCP, TCP_MD5SIG, [1], 4) = 0
0.000 bind(3, ..., ...) = 0
0.000 listen(3, 1) = 0

0.100 < S 0:0(0) win 65535 <mss 1000,sackOK,nop,nop,nop,wscale 7,md5 valid,nop,nop>
0.100 > S. 0:0(0) ack 1 <mss 1460,nop,wscale 6,md5 valid,nop,eol>
0.100 < . 1:1(0) ack 1 win 65535 <md5 valid,nop,nop>
0.100 accept(3, ..., ...) = 4

0.200 < P. 1:1001(1000) ack 1 win 65535
0.300 < P. 1:1001(1000) ack 1 win 65535 <md5 valid,nop,nop>
0.300 > . 1:1(0) ack 1001 <md5 valid,nop,nop>
