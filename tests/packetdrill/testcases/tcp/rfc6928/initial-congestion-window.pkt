// RFC 6928 §2: Increasing TCP's initial window.
// Requirement: SHOULD
// OpenBSD: supported (net.inet.tcp.rfc3390=2)
// Preconditions: net.inet.tcp.rfc3390=2
//
// With MSS 1000 the initial congestion window is 10000 bytes.  OpenBSD
// grows it by one MSS when the ACK that completes the handshake arrives,
// so TCP_INFO reports 11000 for the accepted socket.
--tolerance_usecs=100000

0.000 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
0.000 setsockopt(3, SOL_SOCKET, SO_REUSEADDR, [1], 4) = 0
0.000 bind(3, ..., ...) = 0
0.000 listen(3, 1) = 0

0.100 < S 0:0(0) win 65535 <mss 1000,sackOK,nop,nop,nop,wscale 7>
0.100 > S. 0:0(0) ack 1 <...>
0.100 < . 1:1(0) ack 1 win 65535
0.100 accept(3, ..., ...) = 4

0.100 %{ assert tcpi_snd_cwnd == 11000, tcpi_snd_cwnd }%
0.100 %{ assert tcpi_snd_mss == 1000, tcpi_snd_mss }%
0.100 %{ assert (tcpi_options & TCPI_OPT_WSCALE) != 0, tcpi_options }%
0.100 %{ assert (tcpi_options & TCPI_OPT_SACK) != 0, tcpi_options }%
