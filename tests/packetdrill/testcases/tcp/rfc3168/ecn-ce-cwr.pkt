// Copyright (c) 2026 Sergey Bronnikov
// RFC 3168 §6.1: TCP ECN.
//
// An ECE ACK reduces cwnd; the next data segment carries CWR.
--tolerance_usecs=100000

`sysctl -q net.inet.tcp.ecn=1`

0.000 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
0.000 setsockopt(3, SOL_SOCKET, SO_REUSEADDR, [1], 4) = 0
0.000 bind(3, ..., ...) = 0
0.000 listen(3, 1) = 0

0.100 < SEW 0:0(0) win 65535 <mss 1000,sackOK,nop,nop,nop,wscale 7>
0.100 > SE. 0:0(0) ack 1 <...>
0.100 < . 1:1(0) ack 1 win 65535
0.100 accept(3, ..., ...) = 4

0.200 write(4, ..., 2000) = 2000
0.200 > [ect0] . 1:1001(1000) ack 1 <...>
0.200 > [ect0] P. 1001:2001(1000) ack 1 <...>

// Peer reports congestion experience.
0.300 < E. 1:1(0) ack 1001 win 65535
0.300 %{ assert tcpi_snd_cwnd == 6000, tcpi_snd_cwnd }%

0.400 write(4, ..., 2000) = 2000
0.400 > [ect0] W. 2001:3001(1000) ack 1 <...>
0.400 > [ect0] P. 3001:4001(1000) ack 1 <...>

0.500 < . 1:1(0) ack 4001 win 65535

`sysctl -q net.inet.tcp.ecn=0`
