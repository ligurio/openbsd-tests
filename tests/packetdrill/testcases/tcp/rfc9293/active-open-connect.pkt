// RFC 9293 §3.5: Establishing a connection.
// Requirement: MUST
// OpenBSD: supported
// Preconditions: none
//
// A non-blocking connect() sends SYN and completes after SYN-ACK/ACK.
--tolerance_usecs=100000

0.000 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
0.000 fcntl(3, F_GETFL) = 0x2 (flags O_RDWR)
0.000 fcntl(3, F_SETFL, O_RDWR|O_NONBLOCK) = 0

0.100 connect(3, ..., ...) = -1 EINPROGRESS (Operation now in progress)
0.100 > S 0:0(0) <...>

0.200 < S. 0:0(0) ack 1 win 65535 <mss 1460,sackOK,nop,nop,nop,wscale 7>
0.200 > . 1:1(0) ack 1 <...>
0.200 getsockopt(3, SOL_SOCKET, SO_ERROR, [0], [4]) = 0
0.200 fcntl(3, F_SETFL, O_RDWR) = 0

0.300 write(3, ..., 1000) = 1000
0.300 > P. 1:1001(1000) ack 1 <...>
0.400 < . 1:1(0) ack 1001 win 65535

0.500 close(3) = 0
0.500 > F. 1001:1001(0) ack 1 <...>
0.600 < . 1:1(0) ack 1002 win 65535
