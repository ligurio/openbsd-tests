// RFC 9293 §3.10.7: SEGMENT ARRIVES.
// OpenBSD drops the segment; the listener remains usable.
// Preconditions: none
//
// This is an OpenBSD-specific behavior test; it documents that OpenBSD
// drops a flagless segment and still accepts a later SYN.
--tolerance_usecs=100000

`scripts/defaults.sh`

0.000 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
0.000 setsockopt(3, SOL_SOCKET, SO_REUSEADDR, [1], 4) = 0
0.000 bind(3, ..., ...) = 0
0.000 listen(3, 1) = 0

0.100 < - 0:0(0) win 65535 <mss 1460,sackOK,nop,nop,nop,wscale 7>

// The listener is still usable.
0.200 < S 0:0(0) win 65535 <mss 1460,sackOK,nop,nop,nop,wscale 7>
0.200 > S. 0:0(0) ack 1 <...>
0.300 < . 1:1(0) ack 1 win 65535
0.300 accept(3, ..., ...) = 4
