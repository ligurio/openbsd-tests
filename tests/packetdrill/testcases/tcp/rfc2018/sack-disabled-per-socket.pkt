// SPDX-License-Identifier: MIT
// Copyright (c) 2026 Sergey Bronnikov
// RFC 2018 §2: SACK-Permitted Option.
// Requirement: MAY
// OpenBSD: supported (TCP_SACK_ENABLE)
// Preconditions: net.inet.tcp.sack=1
//
// The listener disables SACK before the handshake, so the connection must
// not negotiate the SACK-permitted option.
--tolerance_usecs=100000

0.000 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
0.000 setsockopt(3, SOL_SOCKET, SO_REUSEADDR, [1], 4) = 0
0.000 setsockopt(3, IPPROTO_TCP, TCP_SACK_ENABLE, [0], 4) = 0
0.000 bind(3, ..., ...) = 0
0.000 listen(3, 1) = 0

0.100 < S 0:0(0) win 65535 <mss 1000,sackOK,nop,nop,nop,wscale 7>
0.100 > S. 0:0(0) ack 1 <...>
0.100 < . 1:1(0) ack 1 win 65535
0.100 accept(3, ..., ...) = 4

0.100 %{ assert (tcpi_options & TCPI_OPT_SACK) == 0, tcpi_options }%
