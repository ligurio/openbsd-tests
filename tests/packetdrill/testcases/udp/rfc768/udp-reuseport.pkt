// RFC 768: User Datagram Protocol.
//
// SO_REUSEPORT allows two UDP sockets to bind the same local port.
--tolerance_usecs=100000

0.000 socket(..., SOCK_DGRAM, IPPROTO_UDP) = 3
0.000 setsockopt(3, SOL_SOCKET, SO_REUSEPORT, [1], 4) = 0
0.000 bind(3, ..., ...) = 0

0.100 socket(..., SOCK_DGRAM, IPPROTO_UDP) = 4
0.100 setsockopt(4, SOL_SOCKET, SO_REUSEPORT, [1], 4) = 0
0.100 bind(4, ..., ...) = 0

0.200 close(4) = 0
0.200 close(3) = 0
