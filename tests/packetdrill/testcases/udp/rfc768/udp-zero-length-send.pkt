// RFC 768: User Datagram Protocol.
//
// A zero-length datagram can be sent with sendto().
--tolerance_usecs=100000

0.000 socket(..., SOCK_DGRAM, IPPROTO_UDP) = 3

0.100 sendto(3, ..., 0, 0, ..., ...) = 0
0.100 > udp(0)

0.200 close(3) = 0
