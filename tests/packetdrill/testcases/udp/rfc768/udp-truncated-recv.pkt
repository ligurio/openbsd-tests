// RFC 768: User Datagram Protocol.
//
// A receive buffer smaller than the datagram truncates the datagram and
// returns the number of bytes copied.
--tolerance_usecs=100000

0.000 socket(..., SOCK_DGRAM, IPPROTO_UDP) = 3
0.000 bind(3, ..., ...) = 0

0.100 < udp(1000)
0.100 recvfrom(3, ..., 100, 0, ..., ...) = 100

0.200 close(3) = 0
