// RFC 768: User Datagram Protocol.
//
// SO_REUSEADDR allows a UDP socket to bind the same local port after the
// previous socket has been closed.
--tolerance_usecs=100000

0.000 socket(..., SOCK_DGRAM, IPPROTO_UDP) = 3
0.000 setsockopt(3, SOL_SOCKET, SO_REUSEADDR, [1], 4) = 0
0.000 bind(3, ..., ...) = 0
0.100 close(3) = 0

0.200 socket(..., SOCK_DGRAM, IPPROTO_UDP) = 4
0.200 setsockopt(4, SOL_SOCKET, SO_REUSEADDR, [1], 4) = 0
0.200 bind(4, ..., ...) = 0
0.300 close(4) = 0
