// RFC 768: User Datagram Protocol.
//
// A connected UDP socket can send datagrams with sendto() and does not
// require a destination address on every call.
--tolerance_usecs=100000

0.000 socket(..., SOCK_DGRAM, IPPROTO_UDP) = 3
0.000 connect(3, ..., ...) = 0

0.100 sendto(3, ..., 1000, 0, ..., ...) = 1000
0.100 > udp(1000)

0.200 close(3) = 0
