// RFC 768: User Datagram Protocol.
//
// A connected UDP socket sends a datagram and the kernel emits one UDP
// packet with the expected payload length.
--tolerance_usecs=100000

0.000 socket(..., SOCK_DGRAM, IPPROTO_UDP) = 3

0.100 sendto(3, ..., 1000, 0, ..., ...) = 1000
0.100 > udp(1000)

0.200 close(3) = 0
