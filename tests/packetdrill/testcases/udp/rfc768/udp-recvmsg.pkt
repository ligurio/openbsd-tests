// RFC 768: User Datagram Protocol.
//
// recvmsg() receives a UDP datagram through an iovec.
--tolerance_usecs=100000

0.000 socket(..., SOCK_DGRAM, IPPROTO_UDP) = 3
0.000 bind(3, ..., ...) = 0

0.100 < udp(1000)
0.100 recvmsg(3, {msg_name(...)=..., msg_iov(1)=[{iov_base=..., iov_len=2000}], msg_control(0)=[], msg_flags=0}, 0) = 1000

0.200 close(3) = 0
