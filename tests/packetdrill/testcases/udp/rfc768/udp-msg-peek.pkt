// RFC 768: User Datagram Protocol.
//
// MSG_PEEK returns the datagram without consuming it; the following read
// returns the same payload.
--tolerance_usecs=100000

0.000 socket(..., SOCK_DGRAM, IPPROTO_UDP) = 3
0.000 bind(3, ..., ...) = 0

0.100 < udp(1000)
0.100 recvfrom(3, ..., 2000, MSG_PEEK, ..., ...) = 1000
0.200 recvfrom(3, ..., 2000, 0, ..., ...) = 1000

0.300 close(3) = 0
