// RFC 768: User Datagram Protocol.
//
// UDP over IPv6: a basic datagram send and receive.
--ip_version=ipv6
--tolerance_usecs=100000

0.000 socket(..., SOCK_DGRAM, IPPROTO_UDP) = 3
0.000 bind(3, ..., ...) = 0

0.100 < udp(1000)
0.100 recvfrom(3, ..., 2000, 0, ..., ...) = 1000

0.200 sendto(3, ..., 1000, 0, ..., ...) = 1000
0.200 > udp(1000)

0.300 close(3) = 0
