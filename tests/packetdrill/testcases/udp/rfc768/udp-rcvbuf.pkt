// RFC 768: User Datagram Protocol.
//
// A UDP socket can enlarge its receive buffer with SO_RCVBUF and still
// receive a normal datagram.
--tolerance_usecs=100000

0.000 socket(..., SOCK_DGRAM, IPPROTO_UDP) = 3
0.000 setsockopt(3, SOL_SOCKET, SO_RCVBUF, [65536], 4) = 0
0.000 bind(3, ..., ...) = 0

0.100 < udp(1000)
0.100 recvfrom(3, ..., 2000, 0, ..., ...) = 1000

0.200 close(3) = 0
